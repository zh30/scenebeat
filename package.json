{
  "name": "scenebeat",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a transcript into an animated motion storyboard, entirely in the browser.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
