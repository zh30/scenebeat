    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.11",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-check": "^4.11.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
